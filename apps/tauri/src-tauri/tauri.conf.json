{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "frowd",
  "version": "0.5.0",
  "identifier": "com.frowang.frowd.tauri.v1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "frowd",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 360,
        "visible": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: frowd-resource: http://frowd-resource.localhost https://frowd-resource.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "mainBinaryName": "frowd-tauri",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "useLocalToolsDir": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "licenses/LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_NOTICES.md": "licenses/TAURI-THIRD-PARTY-NOTICES.md",
      "../LICENSE.SOLOMD": "licenses/LICENSE.SOLOMD",
      "../dependency-licenses.json": "licenses/dependency-licenses.json",
      "../node_modules/@tauri-apps/api/LICENSE-MIT": "licenses/TAURI-LICENSE-MIT",
      "../node_modules/@tauri-apps/api/LICENSE-APACHE-2.0": "licenses/TAURI-LICENSE-APACHE-2.0"
    },
    "publisher": "Fro",
    "category": "Productivity",
    "shortDescription": "frowd Markdown editor",
    "copyright": "Copyright (c) Frowang contributors",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "frowd (Tauri)",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "nsis/installer-hooks.nsh",
        "compression": "lzma"
      }
    }
  },
  "plugins": {}
}
