{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "frowd lite",
  "version": "0.4.0",
  "identifier": "com.frowang.markdown.lite",
  "build": {
    "frontendDist": "../../../out/tauri",
    "devUrl": "http://localhost:5200",
    "beforeDevCommand": "npm run lite:serve",
    "beforeBuildCommand": "npm run lite:web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://document-image.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://document-image.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Frowang contributors",
    "copyright": "MIT",
    "shortDescription": "frowd lite Markdown editor",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
