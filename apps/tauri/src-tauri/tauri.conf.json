{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "frowd",
  "version": "0.5.0",
  "identifier": "com.frowang.frowd.tauri.v1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "frowd",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 360,
        "visible": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: frowd-resource: http://frowd-resource.localhost https://frowd-resource.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "mainBinaryName": "frowd-tauri",
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "license": "MIT",
    "publisher": "Fro",
    "category": "Productivity"
  },
  "plugins": {}
}
