{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fromd",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "fromd",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 360,
        "visible": true,
        "center": true,
        "dragDropEnabled": false,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "infoPlist": "macos/Info.plist",
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 420 },
        "appPosition": { "x": 180, "y": 200 },
        "applicationFolderPosition": { "x": 480, "y": 200 }
      }
    }
  }
}
