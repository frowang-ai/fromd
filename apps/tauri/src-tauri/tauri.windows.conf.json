{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fromd",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "fromd",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 360,
        "visible": true,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "fromd",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "nsis/installer-hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}
