{
  "name": "frowang-markdown",
  "version": "0.5.5",
  "private": true,
  "description": "Local-first Tauri Markdown workspace for Windows and macOS",
  "author": "Frowang contributors",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/editor"
  ],
  "scripts": {
    "dev": "npm run tauri:dev",
    "build": "npm run tauri:web",
    "start": "npm run tauri:dev",
    "test": "node --test tests/*.test.mjs",
    "test:editor": "playwright test -c playwright.editor.config.mjs",
    "test:tauri": "node --test apps/tauri/tests/*.test.mjs",
    "test:tauri:browser": "npm --prefix apps/tauri run test:browser",
    "test:tauri:native": "npm --prefix apps/tauri run test:native",
    "tauri:web": "npm --prefix apps/tauri run build",
    "tauri:check": "cargo check --manifest-path apps/tauri/src-tauri/Cargo.toml --locked",
    "tauri:dev": "npm --prefix apps/tauri run tauri -- dev",
    "tauri:build": "npm --prefix apps/tauri run tauri -- build --no-bundle -- --locked",
    "tauri:installer": "npm run tauri:installer:win",
    "tauri:installer:win": "npm --prefix apps/tauri run tauri -- build --config src-tauri/tauri.windows.conf.json --bundles nsis --target x86_64-pc-windows-msvc -- --locked",
    "tauri:installer:mac": "npm --prefix apps/tauri run tauri -- build --config src-tauri/tauri.macos.conf.json --bundles app,dmg -- --locked"
  },
  "dependencies": {
    "@frowang/editor": "*",
    "vue": "3.5.24"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "5.2.4",
    "vite": "6.4.6"
  }
}
