{
  "name": "frowang-markdown",
  "version": "0.4.0",
  "private": true,
  "description": "A local-first Markdown editor for Windows",
  "author": "Frowang contributors",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "workspaces": ["packages/editor"],
  "scripts": {
    "dev": "electron-vite dev",
    "setup:electron": "node scripts/install-electron-runtime.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "playwright test -c playwright.config.mjs",
    "test:editor": "playwright test -c playwright.editor.config.mjs",
    "package:dir": "npm run build && electron-builder --config electron-builder.config.cjs --win --x64 --dir --publish never",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win portable --x64 --publish never",
    "dist:installer": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "test:update": "playwright test -c playwright.updates.config.mjs",
    "lite:serve": "vite -c vite.tauri.config.mjs",
    "lite:web": "vite build -c vite.tauri.config.mjs",
    "lite:build": "tauri build",
    "lite:dev": "tauri dev"
  },
  "dependencies": {
    "@frowang/editor": "*",
    "@tauri-apps/api": "2.12.4",
    "electron-updater": "6.8.9",
    "semver": "7.8.6",
    "vue": "3.5.24"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.4",
    "@vitejs/plugin-vue": "5.2.4",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "terser": "5.39.0",
    "vite": "6.4.6"
  },
  "build": {
    "appId": "com.frowang.markdown",
    "productName": "frowd",
    "executableName": "Frowang Markdown",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release/0.4.0" },
    "files": ["out/**/*", "package.json"],
    "extraResources": ["LICENSE", "THIRD_PARTY_NOTICES.md"],
    "win": { "target": ["portable", "nsis"], "icon": "apps/desktop/src/renderer/public/icon.png", "signAndEditExecutable": true, "signExecutable": false },
    "portable": { "artifactName": "frowd-${version}-${arch}.exe" }
  }
}
